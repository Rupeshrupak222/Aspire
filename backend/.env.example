# ================================================
#  Aspire Test Platform — BACKEND environment
#  Copy this file to backend/.env and fill in.
#  Never commit a real .env with secrets.
# ================================================

# Port the API server listens on
PORT=3000

# SQLite file location (persist this path with a Docker volume in production)
DB_PATH=./data/aspire.db

# Where the static frontend lives (relative to project root or absolute).
# Leave empty to use the default ../frontend folder.
FRONTEND_DIR=

# Admin panel token (sent as `x-admin-token` or `Authorization: Bearer <token>`).
# If left empty, the server generates a random one and prints it on startup.
ADMIN_TOKEN=

# ---- Judge0 code execution (optional but recommended) ----
# If these are empty, code-writing questions are automatically excluded
# from tests and the admin panel shows a notice.
#
# Option A — RapidAPI hosted Judge0:
#   JUDGE0_ENDPOINT=https://judge0-ce.p.rapidapi.com
#   JUDGE0_API_KEY=<your RapidAPI key>
#   JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
#
# Option B — Self-hosted Judge0 CE (docker run ... judge0/judge0):
#   JUDGE0_ENDPOINT=http://your-judge0-host:2358
#   (leave JUDGE0_API_KEY and JUDGE0_RAPIDAPI_HOST empty)
JUDGE0_ENDPOINT=
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=
