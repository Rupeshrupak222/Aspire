# ================================================
#  Aspire Test Platform — BACKEND environment
#  Copy this file to backend/.env and fill in.
#  Never commit a real .env with secrets.
# ================================================

# Port the API server listens on
PORT=3000

# SQLite file location (persist this path with a Docker volume in production)
DB_PATH=./data/aspire.db

# Where the static frontend lives (relative to project root or absolute).
# Leave empty to use the default ../frontend folder.
FRONTEND_DIR=

# Production Authentication & Identity (Required in production)
# Generate a strong 256-bit secret: openssl rand -hex 32
AUTH_SECRET=<GENERATE_SECURE_SECRET>

# Initial Super Admin (optional in dev, recommended for bootstrap)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# ---- OnlineCompiler.io Execution Engine (Day 9 Primary Provider) ----
# Supply your OnlineCompiler.io API key (never commit real secrets).
# When configured, OnlineCompiler.io is prioritized over Judge0.
ONLINECOMPILER_API_KEY=
ONLINECOMPILER_ENDPOINT=https://api.onlinecompiler.io
# Set to 'true' to enforce API key check on server startup
ONLINECOMPILER_REQUIRED=false
# Set to 'true' to run live cloud execution test during test suite
ONLINECOMPILER_LIVE_TEST=false

# ---- Judge0 code execution (optional / legacy fallback) ----
# If these are empty, code-writing questions are automatically excluded
# from tests and the admin panel shows a notice.
#
# Option A — RapidAPI hosted Judge0:
#   JUDGE0_ENDPOINT=https://judge0-ce.p.rapidapi.com
#   JUDGE0_API_KEY=<your RapidAPI key>
#   JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
#
# Option B — Self-hosted Judge0 CE (docker run ... judge0/judge0):
#   JUDGE0_ENDPOINT=http://your-judge0-host:2358
#   (leave JUDGE0_API_KEY and JUDGE0_RAPIDAPI_HOST empty)
JUDGE0_ENDPOINT=
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=
