# ================================================
#  Aspire Test Platform — Environment Config Example
# ================================================

PORT=3000
DB_PATH=./data/aspire.db
FRONTEND_DIR=

# Production Authentication & Identity (Required in production)
AUTH_SECRET=<GENERATE_SECURE_SECRET>
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# ---- OnlineCompiler.io Execution Engine (Day 9 Primary Provider) ----
# Supply your OnlineCompiler.io API key (never commit real secrets).
# When configured, OnlineCompiler.io is prioritized over Judge0.
ONLINECOMPILER_API_KEY=
ONLINECOMPILER_ENDPOINT=https://api.onlinecompiler.io
# Set to 'true' to enforce API key check on server startup
ONLINECOMPILER_REQUIRED=false
# Set to 'true' to run live cloud execution test during test suite
ONLINECOMPILER_LIVE_TEST=false

# ---- Judge0 code execution (optional / legacy fallback) ----
JUDGE0_ENDPOINT=
JUDGE0_API_KEY=
JUDGE0_RAPIDAPI_HOST=
