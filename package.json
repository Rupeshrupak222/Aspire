    "test:val": "node test/validation-and-errors.test.js",
    "test:sec": "node test/security-hardening.test.js",
    "test:auth": "node test/auth-rbac.test.js",
    "test:db": "node test/database-hardening.test.js",
    "test:qb": "node test/question-bank.test.js",
    "test:exam": "node test/exam-builder.test.js",
    "test:ver": "node test/exam-versioning.test.js",
    "test:code": "node test/coding-execution.test.js",
    "test:async": "node test/async-code-execution.test.js",
    "test:proctoring": "node test/proctoring-analytics.test.js",
    "test:recovery": "node test/network-session-recovery.test.js",
    "test:timer": "node test/timer-submission-reliability.test.js",
    "test:unit": "node test/unit.test.js",
    "test:integration": "node test/integration.test.js",
    "test:api": "node test/api.test.js",
    "test:security": "node test/security-comprehensive.test.js",
