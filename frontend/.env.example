# ================================================
#  Aspire Test Platform — FRONTEND environment
#  The frontend is plain static JS (no build step), so the browser cannot
#  read a .env file directly. These values are the source of truth; copy the
#  real ones into frontend/js/config.js (window.APP_CONFIG) for runtime use.
#  Keep this file as documentation / for a future build pipeline.
# ================================================

# Base URL of the backend API.
# Empty string = same origin (recommended when backend serves the frontend).
# Set to e.g. https://aspire.adyapan.com when hosting the UI separately.
API_BASE_URL=

# Branding shown in the UI
BRAND_NAME=Adyapan
ACCENT_COLOR=#F97316
